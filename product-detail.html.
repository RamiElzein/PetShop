<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Product Details</title>
  <link rel="stylesheet" href="css/style.css">
  <!-- Supabase CDN JS SDK -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body>
  <header>
    <nav>
      <a href="index.html">Home</a>
      <a href="products.html">Products</a>
      <a href="cart.html">Cart</a>
    </nav>
  </header>

  <main class="container">
    <div id="product-detail" class="product-detail-container">
      <p>Loading product details...</p>
    </div>
  </main>

  <script>
    const SUPABASE_URL = 'https://qwarunqonuuqxntlfo.supabase.co';
    const SUPABASE_ANON_KEY = 'sb_publishable__7B1OZCaAdI9Mecm4SlOAw_urzY8tJk';
    const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    async function loadProductDetail() {
      const params = new URLSearchParams(window.location.search);
      const productId = params.get('id');

      if (!productId) {
        document.getElementById('product-detail').innerHTML = '<p>Product not found.</p>';
        return;
      }

      const { data: product, error } = await supabase
        .from('products')
        .select('*')
        .eq('id', productId)
        .single();

      if (error || !product) {
        console.error('Error fetching detail:', error);
        document.getElementById('product-detail').innerHTML = '<p>Unable to load product details.</p>';
        return;
      }

      const container = document.getElementById('product-detail');
      container.innerHTML = `
        <div class="product-detail-card" style="display: flex; gap: 20px; align-items: center; margin-top: 20px;">
          <img src="${product.image || 'https://via.placeholder.com/300'}" alt="${product.name}" style="max-width: 300px; width: 100%; border-radius: 8px;">
          <div>
            <h2>${product.name}</h2>
            <h3 style="color: #2c3e50;">$${product.price}</h3>
            <p>${product.description}</p>
            <button class="btn" onclick="addToCart(${product.id})">Add to Cart</button>
            <br><br>
            <a href="products.html">&larr; Back to Products</a>
          </div>
        </div>
      `;
    }

    function addToCart(id) {
      alert(`Product ${id} added to cart!`);
    }

    document.addEventListener('DOMContentLoaded', loadProductDetail);
  </script>
</body>
</html>